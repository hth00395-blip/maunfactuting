from flask import Flask, request, jsonify

app = Flask(__name__)


@app.route("/api/recommendations", methods=["POST"])
def recommendations():

    data = request.json

    required_quantity = data.get("requiredQuantity", 5)
    required_specs = data.get("requiredSpecifications", [])

    materials = [
        {
            "alternative": 1,
            "material": "Local Polymer A",
            "matchScore": 100.0,
            "availableQuantity": "6 Tons / Month",
            "supplier": "Nile Industrial Materials",
            "location": "Beni Suef"
        },
        {
            "alternative": 2,
            "material": "Local Polymer B",
            "matchScore": 100.0,
            "availableQuantity": "5 Tons / Month",
            "supplier": "Delta Materials",
            "location": "Cairo"
        }
    ]

    result = {
        "systemName": "RECOMMENDATION SYSTEM",

        "factoryRequirements": {
            "requiredQuantity": f"{required_quantity} Tons / Month",
            "requiredSpecifications": required_specs
        },

        "recommendedMaterials": materials,

        "finalRecommendation": {
            "material": "Local Polymer A",
            "matchScore": 100.0,
            "supplier": "Nile Industrial Materials",
            "location": "Beni Suef"
        }
    }

    return jsonify(result)


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)